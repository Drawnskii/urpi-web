# Browser-visible (VITE_ prefix): typed in src/env.d.ts, read only through src/shared/config/env.ts
VITE_API_URL=/api
# Until authentication exists, every request sends these as X-Tenant-ID and X-Tenant-Member-ID.
# The member must belong to the tenant; routes that act as a member (replying in a chat) need it.
VITE_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_TENANT_MEMBER_ID=00000000-0000-0000-0000-000000000000

# Dev server only (no VITE_ prefix, never reaches the browser): where /api is proxied
API_PROXY_TARGET=http://localhost:8000
