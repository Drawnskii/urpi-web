# Browser-visible (VITE_ prefix): typed in src/env.d.ts, read only through src/shared/config/env.ts
VITE_API_URL=/api
# Embedded Signup (Connect WhatsApp): the backend's WHATSAPP_APP_ID and WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID.
# Public, not secrets: Meta's SDK reads them in the browser. Never put WHATSAPP_APP_SECRET here
VITE_WHATSAPP_APP_ID=change-me
VITE_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=change-me
VITE_WHATSAPP_GRAPH_API_VERSION=v25.0

# Dev server only (no VITE_ prefix, never reaches the browser): where /api is proxied
API_PROXY_TARGET=http://localhost:8000
